access.json

# ===== Резервные копии от атомарной записи JSON =====
# Шаблон намеренно шире, чем *.json.bak: копию настроек легко сохранить под
# другим именем (localhost.bak рядом с access.json), и тогда PIN с секретом
# ключей устройств уехали бы в публичный репозиторий вместе с обычным
# git add -A. Ни один файл проекта такие расширения не носит.
*.bak
*.tmp
*.json.bak
*.json.tmp

