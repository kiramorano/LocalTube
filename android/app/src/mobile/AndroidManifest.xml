<?xml version="1.0" encoding="utf-8"?>
<!--
  Мобильная сборка: телефоны и планшеты.

  Тачскрин обязателен по умолчанию, поэтому оставляем его требуемым: сборка
  предназначена для устройств с экраном, к которому прикасаются. leanback
  объявлен необязательным, чтобы APK ставился и на ТВ-приставку, если
  пользователь предпочтёт мобильный интерфейс.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.software.leanback"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
</manifest>
