<?xml version="1.0" encoding="utf-8"?>
<!--
  Сборка для Android TV.

  Отличия от мобильной ровно две: leanback обязателен (без этого лончер и Play
  не считают приложение ТВ-приложением), тачскрина нет. Категория
  LEANBACK_LAUNCHER добавляется к существующему intent-filter главной
  активности через tools:node="merge" — дублировать саму активность не нужно.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <application>
        <activity
            android:name=".MainActivity"
            tools:node="merge">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
